{
  "name": "react-realworld",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "start": "vite --port 4200",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:e2e": "playwright test --grep-invert @security",
    "test:e2e:security": "playwright test --grep @security",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "test:e2e:disabled": "cat e2e/DISABLED_TESTS.md",
    "format": "prettier --write \"**/*.{ts,tsx,html,css,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,html,css,json,md}\"",
    "prepare": "husky install"
  },
  "engines": {
    "node": ">=20.11.1"
  },
  "private": true,
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^5.17.1",
    "@mui/material": "^5.17.1",
    "axios": "^1.9.0",
    "dompurify": "^3.2.6",
    "marked": "^17.0.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.30.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/dompurify": "^3.2.0",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.5.2",
    "husky": "^9.1.7",
    "jsdom": "^27.4.0",
    "lint-staged": "^16.2.7",
    "playwright": "^1.58.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.3",
    "vite": "^6.3.5",
    "vitest": "^4.0.18"
  },
  "lint-staged": {
    "*.{ts,tsx,html,css,json,md}": "prettier --write"
  }
}
